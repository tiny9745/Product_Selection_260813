# ============================================================================
# .gitignore
# ============================================================================

# ---------------------------------------------------------------------------
# Java 編譯產物
# ---------------------------------------------------------------------------
# Compiled class file
*.class

# Log file
*.log

# BlueJ files
*.ctxt

# Mobile Tools for Java (J2ME)
.mtj.tmp/

# Package Files #
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ⚠️ 例外：Gradle Wrapper 的 jar 必須進版控。
# 上面的 *.jar 會誤擋它，少了這個檔案別人 clone 下來無法執行 ./gradlew。
!gradle/wrapper/gradle-wrapper.jar

# virtual machine crash logs, see http://www.java.com/en/download/help/error_hotspot.xml
hs_err_pid*
replay_pid*


# ---------------------------------------------------------------------------
# 建置輸出目錄【新增】
# ---------------------------------------------------------------------------
# 原本只擋 *.class，但建置目錄裡還有大量其他產物（resources 複製品、
# 產生的設定檔、測試報告等），整個目錄排除才乾淨。
/.gradle/
/build/
/bin/
/out/
/target/


# ---------------------------------------------------------------------------
# 敏感設定（最重要，絕不可進版控）
# ---------------------------------------------------------------------------

# .env
.env
.env.local
.env.production

# 環境專用設定檔，通常含密碼／密鑰
application.properties
application-local.properties
application-prod.properties
application-secret.properties

# 憑證與金鑰檔案
*.pem
*.key
*.p12
*.jks
*.keystore

# ⚠️ 例外：範本檔不含真實密鑰，要進版控供團隊參考
!.env.example

# ---------------------------------------------------------------------------
# 使用者上傳的檔案
# ---------------------------------------------------------------------------
# 執行期產生的資料，不屬於原始碼；圖片累積起來會讓 repo 迅速膨脹。
# 對應 application.properties 的 app.upload.dir 設定。
/uploads/

# ---------------------------------------------------------------------------
# 圖片檔
# ---------------------------------------------------------------------------
# 注意：這幾條規則的範圍是「整個專案的所有圖片」，
# 包含 src/main/resources/static 底下專案自己的靜態資源（logo、icon 等）。
#
# 如果之後專案需要納管靜態圖片資源，有兩種處理方式：
#   (A) 刪掉下面四行，改用上面的 /uploads/ 來擋使用者上傳的圖片就好
#   (B) 保留，並針對需要納管的路徑加例外，例如：
#       !src/main/resources/static/**/*.png
#
# 目前專案沒有靜態圖片資源，維持現狀即可。
*.png
*.jpg
*.jpeg
*.tiff

# ---------------------------------------------------------------------------
# IDE 設定檔
# ---------------------------------------------------------------------------
# 這些是各人本機的 IDE 設定，進版控會造成不必要的衝突
# （每個人的路徑、偏好都不同）。

# Eclipse
.classpath
.project
.settings/
.metadata/

# IntelliJ IDEA
.idea/
*.iml
*.iws

# VS Code（保留共用設定，其餘排除）
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json


# ---------------------------------------------------------------------------
# 作業系統產生的檔案
# ---------------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini